# Server-only. Never commit real credentials.
DATABASE_URL="postgresql://regpilot:change-me@localhost:5432/regpilot?schema=public"

# RegPilot AI private pilot — fill in your own environment; never put keys in git.
# The AI API stays disabled unless this is exactly "true".
REGPILOT_AI_ENABLED="false"
# Exact, confirmed email addresses allowed to enrol/use AI (comma separated; NO wildcard).
REGPILOT_AI_ALLOWED_EMAILS=""
# Verified Supabase project's URL and PUBLISHABLE key. Only public keys go to NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Optional separate server-side publishable key; defaults to the public publishable key.
SUPABASE_PUBLISHABLE_KEY=""
# Model must exist in current AI Gateway /v1/models catalogue.
REGPILOT_AI_MODEL=""
# Server-only Gateway key OR Vercel-issued OIDC token. Never add a provider secret client-side.
AI_GATEWAY_API_KEY=""
# AI_USAGE daily hard application cap, in addition to any Gateway spend budget.
REGPILOT_AI_DAILY_USER_LIMIT="10"
REGPILOT_AI_DAILY_ORG_LIMIT="40"

# Secure team task workspace may be enabled separately from billable AI.
# Never use production or confidential information until tenancy is security-reviewed.
REGPILOT_WORKSPACE_ENABLED="false"
# REGPILOT_AI_MODEL and an OIDC token / AI_GATEWAY_API_KEY are mandatory when enabling AI.


# Evidence pilot — OFF until scanner, private bucket, access and privacy validated.
REGPILOT_EVIDENCE_ENABLED="false"
# Server-only secret/service-role key. Never prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""
# Must be created as a PRIVATE bucket; public buckets are rejected.
REGPILOT_EVIDENCE_BUCKET="regpilot-private-evidence"
# ClamAV daemon on a trusted private network; unavailable scanner blocks uploads.
REGPILOT_CLAMD_HOST=""
REGPILOT_CLAMD_PORT="3310"

# Scheduled public-source checks: prepare schedules without activating the worker.
REGPILOT_MONITORING_ENABLED="false"
# Random server-only bearer secret, 32–256 characters; configure external POST trigger separately.
REGPILOT_MONITOR_SECRET=""
# Manual semantic interpretation is separate from source monitoring.
REGPILOT_SEMANTIC_ENABLED="false"
# Set only after documented authentication, privacy, security and provider billing checks.
# This attestation is not itself proof that the checks passed.
REGPILOT_AI_SAFEGUARDS_VERIFIED="false"

# Content-level evidence assessment. Keep disabled until private storage / parsing / privacy checks pass.
REGPILOT_ASSURANCE_ENABLED="false"
# AI sends extracted document text to the configured provider; separate approval gates apply.
REGPILOT_ASSURANCE_AI_ENABLED="false"

# Programme import and connector collection remain off until staged acceptance.
REGPILOT_PROGRAMME_ENABLED="false"
REGPILOT_PROGRAMME_AI_ENABLED="false"
REGPILOT_CONNECTORS_ENABLED="false"
# 32 random bytes encoded as 64 hexadecimal characters, server-only; back up securely.
REGPILOT_CONNECTOR_ENCRYPTION_KEY=""
# External authenticated POST trigger /api/internal/automation uses REGPILOT_MONITOR_SECRET.
REGPILOT_AUTOMATION_ENABLED="false"

# Read-only Microsoft 365 identity connector; separate pilot gate.
REGPILOT_MICROSOFT365_ENABLED="false"

# Paid service stack — prepared only. Setting credentials does NOT activate it.
REGPILOT_PAID_SERVICES_ENABLED="false"
REGPILOT_PAID_SAFEGUARDS_VERIFIED="false"
REGPILOT_APP_ORIGIN="https://regpilot-ai-qnx6.vercel.app"
# Integer micro-USD allocations (1 USD = 1000000). Zero blocks reservations.
# Operator-approved per-operation reserves are allocations, NOT provider invoices.
REGPILOT_PAID_PLATFORM_MONTHLY_MICROS="0"
REGPILOT_PAID_ORG_MONTHLY_MICROS="0"
REGPILOT_AI_RESERVE_MICROS="0"
REGPILOT_OCR_RESERVE_MICROS="0"
REGPILOT_EMAIL_RESERVE_MICROS="0"
REGPILOT_STRIPE_RESERVE_MICROS="0"
REGPILOT_OCR_ENABLED="false"
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=""
AZURE_DOCUMENT_INTELLIGENCE_KEY=""
REGPILOT_EMAIL_ENABLED="false"
RESEND_API_KEY=""
REGPILOT_EMAIL_FROM=""
REGPILOT_SSO_ENABLED="false"
# Exact domains separately configured with Supabase SAML; no wildcard discovery.
REGPILOT_SSO_DOMAINS=""
REGPILOT_STRIPE_ENABLED="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Create/test the recurring product and price separately; never accept client prices.
STRIPE_PRICE_ID=""
# Worker POST /api/internal/services reuses REGPILOT_MONITOR_SECRET.

# Read-only Google Directory collector. Do not enable before operator/provider review.
REGPILOT_GOOGLE_WORKSPACE_ENABLED=false

# Additional read-only collectors. Require the master connector flag; keep disabled.
REGPILOT_GITLAB_ENABLED=false
REGPILOT_CLOUDFLARE_ENABLED=false
REGPILOT_COMPANIES_HOUSE_ENABLED=false
