{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "feature/*": false
    }
  },
  "crons": [
    {
      "path": "/api/internal/cron",
      "schedule": "0 6 * * *"
    }
  ],
  "ignoreCommand": "test \"$(git log -1 --format=%s)\" = 'Activate pinned RegPilot public source watch'"
}
