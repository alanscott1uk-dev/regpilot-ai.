{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "feature/*": false,
      "feature/traceability-benchmark-batch-20261106": false
    }
  },
  "crons": [
    {
      "path": "/api/internal/cron",
