generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum ObligationStatus {
  OPEN
  IN_PROGRESS
  COMPLETE
}

enum AiReviewState {
  PENDING_REVIEW
  REVIEWED
  NEEDS_CHANGES
  REDACTED
}

enum SourceReviewState {
 NEEDS_REVIEW
 REVIEWED
 NOT_APPLICABLE
}

enum ScanStatus {
  CLEAN
  QUARANTINED
}

enum ReviewStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  externalId  String       @unique
  email       String       @unique
  createdAt   DateTime     @default(now())
  memberships Membership[]
  auditEvents AuditEvent[]
  aiReviewsCreated AiReview[] @relation("AiReviewCreator")
  regulatoryReviews RegulatorySnapshot[] @relation("RegulatorySnapshotReviewer")
  regulatoryCaptures RegulatorySnapshot[] @relation("RegulatorySnapshotCapturer")
  aiReviewsChecked AiReview[] @relation("AiReviewReviewer")
  aiDailyUsage AiDailyUsage[]
  evidenceUploaded Evidence[] @relation("EvidenceUploader")
  evidenceReviewed Evidence[] @relation("EvidenceReviewer")
  businessProfilesUpdated BusinessProfile[]
  intelligenceCreated IntelligenceRun[]
  intelligenceReviewed IntelligenceDecision[]
  watchSchedules WatchSchedule[]
  semanticRequests SemanticRequest[]
  assuranceCreated AssuranceAssessment[] @relation("AssuranceCreator")
  assuranceReviewed AssuranceAssessment[] @relation("AssuranceReviewer")
  programmeCreated ProgrammeImport[] @relation("ProgrammeCreator")
  programmeReviewed ProgrammeImport[] @relation("ProgrammeReviewer")
  managedControls ManagedControl[] @relation("ControlOwner")
  scheduledControls ManagedControl[] @relation("ControlScheduler")
  assignedTasks Obligation[]
  connectorConfigurations EvidenceConnector[]
  controlMappings ControlLink[]
  registeredSources RegisteredSource[]
  libraryDrafts LibraryRevision[] @relation("LibraryAuthor")
  libraryReviews LibraryRevision[] @relation("LibraryReviewer")
  applicabilityDecisions LibraryApplicability[] @relation("ApplicabilityReviewer")
  applicabilityOwnership LibraryApplicability[] @relation("ApplicabilityOwner")
  coverageRuns CoverageRun[]
  coverageDecisions CoverageDecision[]
  workspaceInvitations WorkspaceInvitation[] @relation("InvitationIssuer")
  serviceJobs ServiceJob[]
  paidReservations PaidReservation[]
  paidBudgetConfigurations PaidBudget[]
  auditRooms AuditRoom[]
  auditGrants AuditGrant[]
  auditQuestions AuditQuestion[]
  policyDrafts PolicyRevision[] @relation("PolicyAuthor")
  policyReviews PolicyRevision[] @relation("PolicyReviewer")
  policyAssignments PolicyAssignment[]
  vendors Vendor[]
  vendorDrafts VendorReview[] @relation("VendorAuthor")
  vendorReviews VendorReview[] @relation("VendorReviewer")
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime     @default(now())
  memberships Membership[]
  obligations Obligation[]
  evidence    Evidence[]
  auditEvents AuditEvent[]
  aiReviews AiReview[]
  regulatorySnapshots RegulatorySnapshot[]
  aiDailyUsage AiDailyUsage[]
  evidenceCount Int @default(0)
  evidenceBytes BigInt @default(0)
  businessProfile BusinessProfile?
  intelligenceRuns IntelligenceRun[]
  watchSchedules WatchSchedule[]
  semanticRequests SemanticRequest[]
  assuranceAssessments AssuranceAssessment[]
  programmeImports ProgrammeImport[]
  managedControls ManagedControl[]
  evidenceConnectors EvidenceConnector[]
  connectorRuns ConnectorRun[]
  controlLinks ControlLink[]
  registeredSources RegisteredSource[]
  libraryRequirements LibraryRequirement[]
  libraryRevisions LibraryRevision[]
  libraryApplicability LibraryApplicability[]
  coverageRuns CoverageRun[]
  coverageDecisions CoverageDecision[]
  workspaceInvitations WorkspaceInvitation[]
  paidBudget PaidBudget?
  paidReservations PaidReservation[]
  serviceJobs ServiceJob[]
  billingAccount BillingAccount?
  billingEvents BillingEvent[]
  auditRooms AuditRoom[]
  auditGrants AuditGrant[]
  auditQuestions AuditQuestion[]
  policies Policy[]
  policyRevisions PolicyRevision[]
  policyAssignments PolicyAssignment[]
  vendors Vendor[]
  vendorReviews VendorReview[]
}

model PaidBudget {
 organizationId String @id @db.Uuid
 monthlyLimitMicros Int
 remindersEnabled Boolean @default(false)
 configuredById String? @db.Uuid
 configuredBy User? @relation(fields:[configuredById],references:[id],onDelete:SetNull)
 version Int @default(1)
 updatedAt DateTime @updatedAt
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
}

model PaidReservation {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 userId String @db.Uuid
 requestKey String @db.VarChar(140)
 service String @db.VarChar(24)
 units Int
 reservedMicros Int
 month DateTime @db.Date
 createdAt DateTime @default(now())
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 user User @relation(fields:[userId],references:[id],onDelete:Restrict)
 @@unique([organizationId,requestKey])
 @@index([month,organizationId])
}

model ServiceJob {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 createdById String @db.Uuid
 kind String @db.VarChar(24)
 targetId String? @db.Uuid
 sourceHash String? @db.VarChar(64)
 dedupeKey String @db.VarChar(180)
 status String @default("DRAFT") @db.VarChar(24)
 version Int @default(1)
 units Int @default(1)
 recipientId String? @db.Uuid
 leaseToken String? @db.Uuid
 leaseUntil DateTime?
 failureCode String? @db.VarChar(48)
 result Json?
 resultHash String? @db.VarChar(64)
 providerId String? @unique @db.VarChar(200)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 creator User @relation(fields:[createdById],references:[id],onDelete:Restrict)
 @@unique([organizationId,dedupeKey])
 @@index([status,createdAt])
 @@index([organizationId,createdAt])
}

model BillingAccount {
 organizationId String @id @db.Uuid
 customerId String @unique @db.VarChar(120)
 subscriptionId String? @unique @db.VarChar(120)
 status String @default("PENDING") @db.VarChar(40)
 lastEventAt Int @default(0)
 updatedAt DateTime @updatedAt
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
}

model BillingEvent {
 id String @id @db.VarChar(120)
 organizationId String @db.Uuid
 eventType String @db.VarChar(100)
 createdAt DateTime @default(now())
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 @@index([organizationId,createdAt])
}

model WorkspaceInvitation {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  email String @db.VarChar(254)
  role MembershipRole
  invitedById String @db.Uuid
  status String @default("PENDING") @db.VarChar(16)
  version Int @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  invitedBy User @relation("InvitationIssuer",fields:[invitedById],references:[id],onDelete:Restrict)
  @@index([organizationId,status,expiresAt])
  @@index([email,status,expiresAt])
}

model Membership {
  organizationId String @db.Uuid
  userId         String @db.Uuid
  role           MembershipRole @default(VIEWER)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([organizationId, userId])
}

model Obligation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  title          String
  category       String
  ownerName      String
  dueDate        DateTime         @db.Date
  status         ObligationStatus @default(OPEN)
  completionException Boolean @default(false)
  completionRationale String @default("")
  completedAt DateTime?
  notes          String           @default("")
  sourceUrl      String?
  sourceCheckedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  evidence       Evidence[]
  originKey      String? @db.VarChar(64)
  automationKey String? @db.VarChar(64)
  assigneeId String? @db.Uuid
  controlId String? @db.Uuid
  connectorId String? @db.Uuid
  assignee User? @relation(fields:[assigneeId],references:[id],onDelete:Restrict)
  managedControl ManagedControl? @relation(fields:[controlId,organizationId],references:[id,organizationId],onDelete:Restrict)
  evidenceConnector EvidenceConnector? @relation(fields:[connectorId,organizationId],references:[id,organizationId],onDelete:Restrict)
  controlLinks ControlLink[]
  intelligenceDecisions IntelligenceDecision[]
  assuranceAssessments AssuranceAssessment[]
  @@unique([id, organizationId])
  @@unique([organizationId, originKey])
  @@unique([organizationId, automationKey])
  @@index([organizationId,controlId,status])
  @@index([organizationId,connectorId,status])
  @@index([organizationId, status, dueDate])
}

model Evidence {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  obligationId   String       @db.Uuid
  filename       String
  storageKey     String
  contentType    String
  sizeBytes      Int
  sha256         String
  scannedAt      DateTime?
  scanStatus     ScanStatus @default(QUARANTINED)
  uploadedById   String? @db.Uuid
  reviewerId     String? @db.Uuid
  reviewerNotes  String @default("")
  reviewedAt     DateTime?
  reviewVersion  Int @default(1)
  reviewStatus   ReviewStatus @default(DRAFT)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  obligation     Obligation   @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  uploadedBy      User? @relation("EvidenceUploader",fields:[uploadedById],references:[id],onDelete:Restrict)
  reviewer        User? @relation("EvidenceReviewer",fields:[reviewerId],references:[id],onDelete:Restrict)
  @@index([organizationId, obligationId])
}

model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorId        String       @db.Uuid
  action         String
  entityType     String
  entityId       String
  details        Json
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([organizationId, createdAt])
}


// Daily reservation counter. Enforced by server-side Serializable transaction.
// This table must be migrated before enabling the AI endpoint.
model AiDailyUsage {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  day            DateTime @db.Date
  count          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  user           User @relation(fields:[userId],references:[id],onDelete:Restrict)
  @@unique([organizationId, userId, day])
  @@index([organizationId, day])
}


// Stores model-generated draft OUTPUT only when the user explicitly opts in.
// No original PDF bytes, prompt, source document, or patient data belong here.
model AiReview {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @db.Uuid
  createdById      String        @db.Uuid
  requestId        String        @unique @db.Uuid
  mode             String
  modelId          String
  sourceUrl        String?
  result           Json
  resultSha256     String        @db.VarChar(64)
  status           AiReviewState @default(PENDING_REVIEW)
  reviewerId       String?       @db.Uuid
  reviewerNotes    String        @default("")
  reviewedAt       DateTime?
  version          Int           @default(1)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  organization     Organization  @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  creator          User          @relation("AiReviewCreator",fields:[createdById],references:[id],onDelete:Restrict)
  reviewer         User?         @relation("AiReviewReviewer",fields:[reviewerId],references:[id],onDelete:Restrict)
  @@index([organizationId,status,createdAt])
  @@index([organizationId,createdAt])
}


// Stores snapshots of an explicit, allowlisted GOV.UK source at the time the
// authorised operator checked it. No autonomous monitoring is implied.
model RegulatorySnapshot {
  id               String @id @default(uuid()) @db.Uuid
  organizationId   String @db.Uuid
  sourceId         String @db.VarChar(120)
  title            String @db.VarChar(300)
  url              String @db.VarChar(500)
  contentHash      String @db.VarChar(64)
  bodyText         String @db.Text
  revisionAt       String? @db.VarChar(100)
  addedSnippets    Json @default("[]")
  removedSnippets  Json @default("[]")
  reviewStatus     SourceReviewState @default(NEEDS_REVIEW)
  reviewNotes      String @default("")
  reviewerId       String? @db.Uuid
  capturedById     String @db.Uuid
  reviewedAt       DateTime?
  version          Int @default(1)
  firstCapturedAt  DateTime @default(now())
  lastCheckedAt    DateTime @default(now())
  organization     Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  reviewer         User? @relation("RegulatorySnapshotReviewer",fields:[reviewerId],references:[id],onDelete:Restrict)
  capturedBy       User @relation("RegulatorySnapshotCapturer",fields:[capturedById],references:[id],onDelete:Restrict)
  intelligenceRuns IntelligenceRun[]
  semanticRequests SemanticRequest[]
  assuranceAssessments AssuranceAssessment[]
  @@unique([id, organizationId])
  @@index([organizationId,sourceId,firstCapturedAt])
}

// Server-only intelligence records; Data API access is revoked by security SQL.
model BusinessProfile {
  facts Json @default("{}")
  organizationId String @id @db.Uuid
  activities Json
  jurisdictions Json
  version Int @default(1)
  updatedById String @db.Uuid
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  updatedBy User @relation(fields:[updatedById],references:[id],onDelete:Restrict)
}

model IntelligenceRun {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  snapshotId String @db.Uuid
  profileVersion Int
  profile Json
  engineVersion String @db.VarChar(80)
  result Json
  resultHash String @db.VarChar(64)
  createdById String @db.Uuid
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  creator User @relation(fields:[createdById],references:[id],onDelete:Restrict)
  snapshot RegulatorySnapshot @relation(fields:[snapshotId,organizationId],references:[id,organizationId],onDelete:Restrict)
  decisions IntelligenceDecision[]
  @@unique([id,organizationId])
  @@unique([organizationId,snapshotId,profileVersion,engineVersion])
  @@index([organizationId,createdAt])
}

model IntelligenceDecision {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  runId String @db.Uuid
  candidateKey String @db.VarChar(64)
  decision String @db.VarChar(20)
  rationale String @db.VarChar(800)
  reviewerId String @db.Uuid
  obligationId String? @db.Uuid
  createdAt DateTime @default(now())
  run IntelligenceRun @relation(fields:[runId,organizationId],references:[id,organizationId],onDelete:Restrict)
  reviewer User @relation(fields:[reviewerId],references:[id],onDelete:Restrict)
  obligation Obligation? @relation(fields:[obligationId,organizationId],references:[id,organizationId],onDelete:Restrict)
  @@unique([runId,candidateKey])
  @@index([organizationId,createdAt])
}

// Persistent leases prevent concurrent dispatch. Scheduling is opt-in and off by default.
model WatchSchedule {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  sourceId String @db.VarChar(120)
  configuredById String @db.Uuid
  enabled Boolean @default(false)
  intervalHours Int @default(24)
  version Int @default(1)
  nextCheckAt DateTime @default(now())
  leaseToken String? @db.Uuid
  leaseUntil DateTime?
  attempts Int @default(0)
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  lastOutcome String? @db.VarChar(40)
  failureCode String? @db.VarChar(40)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  configuredBy User @relation(fields:[configuredById],references:[id],onDelete:Restrict)
  @@unique([organizationId,sourceId])
  @@index([enabled,nextCheckAt])
}

// One provider attempt per source/profile/engine. Interrupted attempts are not replayed.
model SemanticRequest {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  snapshotId String @db.Uuid
  profileVersion Int
  engineVersion String @db.VarChar(80)
  modelId String @db.VarChar(160)
  createdById String @db.Uuid
  status String @default("RUNNING") @db.VarChar(24)
  failureCode String? @db.VarChar(40)
  createdAt DateTime @default(now())
  finishedAt DateTime?
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  snapshot RegulatorySnapshot @relation(fields:[snapshotId,organizationId],references:[id,organizationId],onDelete:Restrict)
  creator User @relation(fields:[createdById],references:[id],onDelete:Restrict)
  @@unique([organizationId,snapshotId,profileVersion,engineVersion])
  @@index([organizationId,createdAt])
}

// Content-level evidence assessment. Draft interpretation is never an approval.
model AssuranceAssessment {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  obligationId String @db.Uuid
  snapshotId String @db.Uuid
  profileVersion Int
  inputHash String @db.VarChar(64)
  engineVersion String @db.VarChar(80)
  method String @db.VarChar(20)
  evidenceManifest Json
  result Json?
  resultHash String? @db.VarChar(64)
  status String @default("PROCESSING") @db.VarChar(24)
  failureCode String? @db.VarChar(40)
  createdById String @db.Uuid
  reviewerId String? @db.Uuid
  reviewNotes String @default("") @db.VarChar(1200)
  selectedPassages Json @default("[]")
  reviewedAt DateTime?
  validUntil DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  obligation Obligation @relation(fields:[obligationId,organizationId],references:[id,organizationId],onDelete:Restrict)
  snapshot RegulatorySnapshot @relation(fields:[snapshotId,organizationId],references:[id,organizationId],onDelete:Restrict)
  creator User @relation("AssuranceCreator",fields:[createdById],references:[id],onDelete:Restrict)
  reviewer User? @relation("AssuranceReviewer",fields:[reviewerId],references:[id],onDelete:Restrict)
  @@unique([organizationId,inputHash,method])
  @@index([organizationId,obligationId,createdAt])
}


// Reviewable import of existing documents. No automatic activation of inferred controls.
model ProgrammeImport {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 createdById String @db.Uuid
 reviewerId String? @db.Uuid
 inputHash String @db.VarChar(64)
 evidenceManifest Json
 method String @db.VarChar(20)
 status String @default("PROCESSING") @db.VarChar(24)
 result Json?
 resultHash String? @db.VarChar(64)
 reviewNotes String @default("") @db.VarChar(1200)
 attempts Int @default(1)
 lastStartedAt DateTime @default(now())
 version Int @default(1)
 createdAt DateTime @default(now())
 reviewedAt DateTime?
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
 creator User @relation("ProgrammeCreator",fields:[createdById],references:[id],onDelete:Restrict)
 reviewer User? @relation("ProgrammeReviewer",fields:[reviewerId],references:[id],onDelete:Restrict)
 controls ManagedControl[]
 @@unique([id,organizationId])
 @@unique([organizationId,inputHash,method])
 @@index([organizationId,createdAt])
}

model ManagedControl {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 importId String @db.Uuid
 proposalKey String @db.VarChar(64)
 title String @db.VarChar(160)
 description String @db.VarChar(1600)
 testProcedure String @db.VarChar(1600)
 theme String @db.VarChar(40)
 ownerId String @db.Uuid
 scheduledById String @db.Uuid
 intervalDays Int
 nextReviewAt DateTime @db.Date
 enabled Boolean @default(true)
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
 programmeImport ProgrammeImport @relation(fields:[importId,organizationId],references:[id,organizationId],onDelete:Restrict)
 owner User @relation("ControlOwner",fields:[ownerId],references:[id],onDelete:Restrict)
 scheduledBy User @relation("ControlScheduler",fields:[scheduledById],references:[id],onDelete:Restrict)
 tasks Obligation[]
 connectors EvidenceConnector[]
 links ControlLink[]
 coverageDecisions CoverageDecision[]
 @@unique([id,organizationId])
 @@unique([importId,proposalKey])
 @@index([organizationId,enabled,nextReviewAt])
}

// Human-approved scope link; not a claim of certified framework equivalence.
model ControlLink {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 controlId String @db.Uuid
 obligationId String @db.Uuid
 mappedById String @db.Uuid
 rationale String @db.VarChar(1200)
 createdAt DateTime @default(now())
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
 control ManagedControl @relation(fields:[controlId,organizationId],references:[id,organizationId],onDelete:Restrict)
 obligation Obligation @relation(fields:[obligationId,organizationId],references:[id,organizationId],onDelete:Restrict)
 mappedBy User @relation(fields:[mappedById],references:[id],onDelete:Restrict)
 @@unique([controlId,obligationId])
 @@index([organizationId,obligationId])
}

model EvidenceConnector {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 controlId String @db.Uuid
 configuredById String @db.Uuid
 provider String @default("GITHUB") @db.VarChar(24)
 repository String @db.VarChar(220)
 branch String @db.VarChar(120)
 encryptedSecret String? @db.Text
 enabled Boolean @default(false)
 version Int @default(1)
 intervalHours Int @default(24)
 nextRunAt DateTime @default(now())
 leaseToken String? @db.Uuid
 leaseUntil DateTime?
 attempts Int @default(0)
 lastSuccessAt DateTime?
 failureCode String? @db.VarChar(40)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
 control ManagedControl @relation(fields:[controlId,organizationId],references:[id,organizationId],onDelete:Restrict)
 configuredBy User @relation(fields:[configuredById],references:[id],onDelete:Restrict)
 runs ConnectorRun[]
 tasks Obligation[]
 @@unique([id,organizationId])
 @@unique([organizationId,repository,branch])
 @@index([enabled,nextRunAt])
}

model ConnectorRun {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 connectorId String @db.Uuid
 leaseToken String @unique @db.Uuid
 configVersion Int
 result Json
 resultHash String @db.VarChar(64)
 signalHash String @db.VarChar(64)
 outcome String @db.VarChar(24)
 capturedAt DateTime @default(now())
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
 connector EvidenceConnector @relation(fields:[connectorId,organizationId],references:[id,organizationId],onDelete:Restrict)
 @@index([organizationId,connectorId,capturedAt])
}


model RegisteredSource {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 sourceId String @db.VarChar(120)
 path String @db.VarChar(450)
 title String @db.VarChar(300)
 documentType String @db.VarChar(120)
 registeredById String @db.Uuid
 createdAt DateTime @default(now())
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
 registeredBy User @relation(fields:[registeredById],references:[id],onDelete:Restrict)
 @@unique([organizationId,sourceId])
 @@unique([organizationId,path])
}

model LibraryRequirement {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 collection String @db.VarChar(100)
 reference String @db.VarChar(100)
 currentRevision Int @default(0)
 version Int @default(1)
 createdAt DateTime @default(now())
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
 revisions LibraryRevision[]
 @@unique([id,organizationId])
 @@unique([organizationId,collection,reference])
 @@index([organizationId,createdAt,id])
}

model LibraryRevision {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 requirementId String @db.Uuid
 number Int
 status String @default("DRAFT") @db.VarChar(20)
 content Json
 contentHash String @db.VarChar(64)
 provenance Json
 provenanceHash String @db.VarChar(64)
 createdById String @db.Uuid
 reviewerId String? @db.Uuid
 reviewNotes String @default("") @db.VarChar(1200)
 version Int @default(1)
 createdAt DateTime @default(now())
 reviewedAt DateTime?
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
 requirement LibraryRequirement @relation(fields:[requirementId,organizationId],references:[id,organizationId],onDelete:Restrict)
 creator User @relation("LibraryAuthor",fields:[createdById],references:[id],onDelete:Restrict)
 reviewer User? @relation("LibraryReviewer",fields:[reviewerId],references:[id],onDelete:Restrict)
 applicability LibraryApplicability[]
 coverageDecisions CoverageDecision[]
