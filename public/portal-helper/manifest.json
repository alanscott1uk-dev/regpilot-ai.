{
  "manifest_version": 3,
  "name": "RegPilot questionnaire hand-off",
  "version": "2.3.0",
  "description": "Start a questionnaire on the buyer page and return reviewed answers to the same tab.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "homepage_url": "https://regpilot-ai-qnx6.vercel.app/team/questionnaires",
  "externally_connectable": {
    "matches": [
      "https://regpilot-ai-qnx6.vercel.app/*"
    ]
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
