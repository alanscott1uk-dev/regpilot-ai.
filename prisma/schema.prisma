 evaluationCasesReviewed EvaluationCase[] @relation("EvaluationCaseReviewer")
 evaluationRuns EvaluationRun[] @relation("EvaluationRunCreator")
 evaluationAnswerReviews EvaluationAnswerReview[] @relation("EvaluationAnswerReviewer")
