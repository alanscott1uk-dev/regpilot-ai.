generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WorkerRun {
 id String @id @default(uuid()) @db.Uuid
 invocationKey String @unique @db.VarChar(80)
 state String @default("RUNNING") @db.VarChar(20)
 slot Int @default(0)
 startedAt DateTime @default(now())
 leaseUntil DateTime
 finishedAt DateTime?
 codeCommit String? @db.VarChar(40)
 summary Json?
 @@index([state, startedAt])
 @@index([startedAt])
 @@index([slot,state,leaseUntil])
}

model DispatchLane {
 organizationId String @db.Uuid
 kind String @db.VarChar(20)
 lastDispatchedAt DateTime?
 leaseToken String? @db.Uuid
 leaseUntil DateTime?
 dispatchCount Int @default(0)
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 @@id([organizationId,kind])
 @@index([kind,lastDispatchedAt,organizationId])
}

model AutomationEvent {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 connectorId String @db.Uuid
 eventKey String @unique @db.VarChar(64)
 kind String @db.VarChar(24)
 configVersion Int
 runId String? @db.Uuid
 fingerprint String @db.VarChar(64)
 changed Boolean @default(false)
 reasonCode String? @db.VarChar(40)
 state String @default("PENDING") @db.VarChar(20)
 attempts Int @default(0)
 replayCount Int @default(0)
 version Int @default(1)
 availableAt DateTime @default(now())
 leaseToken String? @db.Uuid
 leaseUntil DateTime?
 lastErrorCode String? @db.VarChar(40)
 finishedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 connector EvidenceConnector @relation(fields:[connectorId,organizationId],references:[id,organizationId],onDelete:Cascade)
 @@index([organizationId,state,availableAt])
 @@index([organizationId,state,leaseUntil])
 @@index([state,createdAt])
}

model ProviderGate {
 provider String @id @db.VarChar(24)
 generation Int @default(0)
 failures Int @default(0)
 failureScopes Json @default("[]")
 lastFailureAt DateTime?
 trips Int @default(0)
 openUntil DateTime?
 probeToken String? @db.Uuid
 probeUntil DateTime?
 permits ProviderPermit[]
}

model PublicSourceFetch {
 key String @id @db.VarChar(64)
 sourceId String @db.VarChar(120)
 payload Json?
 payloadHash String? @db.VarChar(64)
 fetchedAt DateTime?
 expiresAt DateTime?
 leaseToken String? @db.Uuid
 leaseUntil DateTime?
 retryAt DateTime?
 failures Int @default(0)
 failureCode String? @db.VarChar(40)
 updatedAt DateTime @updatedAt
 @@index([updatedAt])
}

model ProviderPermit {
 token String @id @db.Uuid
 provider String @db.VarChar(24)
 generation Int
 scopeHash String @db.VarChar(64)
 probe Boolean @default(false)
 expiresAt DateTime
 gate ProviderGate @relation(fields:[provider],references:[provider],onDelete:Cascade)
 @@index([provider,expiresAt])
}

enum MembershipRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum ObligationStatus {
  OPEN
  IN_PROGRESS
  COMPLETE
}

enum AiReviewState {
  PENDING_REVIEW
  REVIEWED
  NEEDS_CHANGES
  REDACTED
}

enum SourceReviewState {
 NEEDS_REVIEW
 REVIEWED
 NOT_APPLICABLE
}

enum ScanStatus {
  CLEAN
  QUARANTINED
}

enum ReviewStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model User {
 lossScenarios RiskLossScenario[]
 aiSystemsOwned AiSystem[] @relation("AiSystemOwner")
 aiSystemsEdited AiSystem[] @relation("AiSystemEditor")
 aiSystemDecisions AiSystemDecision[]
 horizonWatchlistsChanged HorizonWatchlist[]
