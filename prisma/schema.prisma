 evidenceApplicabilitiesUpdated EvidenceApplicability[] @relation("EvidenceScopeUpdater")
 qualityCasesCreated QualityCase[] @relation("QualityCreator")
 qualityCasesOwned QualityCase[] @relation("QualityOwner")
 qualityActionsCreated QualityAction[] @relation("QualityActionCreator")
 qualityEffectivenessPrepared QualityEffectiveness[] @relation("QualityEffectivenessAuthor")
 qualityEffectivenessDecided QualityEffectiveness[] @relation("QualityEffectivenessReviewer")
 qualityOperations QualityOperation[] @relation("QualityOperationActor")
 knowledgeIndexes KnowledgeIndexRun[]
 knowledgeSearches KnowledgeSearchRun[]
 risksCreated RiskRecord[] @relation("RiskCreator")
 risksOwned RiskRecord[] @relation("RiskOwner")
 riskReviewsPrepared RiskReview[] @relation("RiskReviewAuthor")
 riskReviewsDecided RiskReview[] @relation("RiskReviewReviewer")
 connectorControlLinks ConnectorControlLink[]
 accessInventories AccessInventory[]
 accessCampaignsCreated AccessCampaign[] @relation("AccessCreator")
 accessCampaignsClosed AccessCampaign[] @relation("AccessCloser")
 accessItemsReviewed AccessReviewItem[] @relation("AccessReviewer")
 accessItemsSubmitted AccessReviewItem[] @relation("AccessSubmitter")
 accessItemsVerified AccessReviewItem[] @relation("AccessVerifier")
 assuranceAnswersWritten AssuranceAnswer[] @relation("AnswerAuthor")
 assuranceAnswersReviewed AssuranceAnswer[] @relation("AnswerReviewer")
 questionnairesCreated AssuranceQuestionnaire[] @relation("QuestionnaireAuthor")
 questionnairesReviewed AssuranceQuestionnaire[] @relation("QuestionnaireReviewer")
 questionnaireDrafts QuestionnaireDraftRun[]
 changeResponsesCreated ChangeResponse[] @relation("ChangeResponseCreator")
 changeResponsesClosed ChangeResponse[] @relation("ChangeResponseCloser")
 changeActionsSubmitted ChangeAction[] @relation("ChangeActionSubmitter")
 changeActionsReviewed ChangeAction[] @relation("ChangeActionReviewer")
 auditSubmissions AuditRequest[] @relation("AuditRequestSubmitter")
 auditRequestReviews AuditRequest[] @relation("AuditRequestReviewer")
  id          String       @id @default(uuid()) @db.Uuid
  externalId  String       @unique
  email       String       @unique
  createdAt   DateTime     @default(now())
  memberships Membership[]
  auditEvents AuditEvent[]
  aiReviewsCreated AiReview[] @relation("AiReviewCreator")
  regulatoryReviews RegulatorySnapshot[] @relation("RegulatorySnapshotReviewer")
  regulatoryCaptures RegulatorySnapshot[] @relation("RegulatorySnapshotCapturer")
  aiReviewsChecked AiReview[] @relation("AiReviewReviewer")
  aiDailyUsage AiDailyUsage[]
  evidenceUploaded Evidence[] @relation("EvidenceUploader")
  evidenceReviewed Evidence[] @relation("EvidenceReviewer")
  businessProfilesUpdated BusinessProfile[]
  intelligenceCreated IntelligenceRun[]
  intelligenceReviewed IntelligenceDecision[]
  watchSchedules WatchSchedule[]
  semanticRequests SemanticRequest[]
  assuranceCreated AssuranceAssessment[] @relation("AssuranceCreator")
  assuranceReviewed AssuranceAssessment[] @relation("AssuranceReviewer")
  programmeCreated ProgrammeImport[] @relation("ProgrammeCreator")
  programmeReviewed ProgrammeImport[] @relation("ProgrammeReviewer")
  managedControls ManagedControl[] @relation("ControlOwner")
  scheduledControls ManagedControl[] @relation("ControlScheduler")
  assignedTasks Obligation[]
  connectorConfigurations EvidenceConnector[]
  controlMappings ControlLink[]
  registeredSources RegisteredSource[]
  libraryDrafts LibraryRevision[] @relation("LibraryAuthor")
  libraryReviews LibraryRevision[] @relation("LibraryReviewer")
  applicabilityDecisions LibraryApplicability[] @relation("ApplicabilityReviewer")
  applicabilityOwnership LibraryApplicability[] @relation("ApplicabilityOwner")
  coverageRuns CoverageRun[]
  coverageDecisions CoverageDecision[]
  workspaceInvitations WorkspaceInvitation[] @relation("InvitationIssuer")
  serviceJobs ServiceJob[]
  paidReservations PaidReservation[]
  paidBudgetConfigurations PaidBudget[]
  auditRooms AuditRoom[]
  auditGrants AuditGrant[]
  auditQuestions AuditQuestion[]
  policyDrafts PolicyRevision[] @relation("PolicyAuthor")
  policyReviews PolicyRevision[] @relation("PolicyReviewer")
  policyAssignments PolicyAssignment[]
  vendors Vendor[]
  vendorDrafts VendorReview[] @relation("VendorAuthor")
  vendorReviews VendorReview[] @relation("VendorReviewer")
}

