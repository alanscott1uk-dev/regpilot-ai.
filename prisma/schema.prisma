 horizonWatchlists HorizonWatchlist[]
 evaluationCases EvaluationCase[]
 evaluationRuns EvaluationRun[]
 evaluationAnswerReviews EvaluationAnswerReview[]
 evaluationOperations EvaluationOperation[]
 integrationEndpoints IntegrationEndpoint[]
 integrationEndpointControls IntegrationEndpointControl[]
 integrationEvents IntegrationEvent[]
 integrationDeliveries IntegrationDelivery[]
 integrationAttempts IntegrationAttempt[]
 integrationBudgets IntegrationBudget[]
 integrationOperations IntegrationOperation[]
  ocrRuns OcrRun[]
  ocrReviews OcrReview[]
  policyReleases PolicyRelease[]
  signatureChallenges DocumentSignatureChallenge[]
  documentAttestations DocumentAttestation[]
  effectivityOperations PolicyEffectivityOperation[]
 customerApiCredentials CustomerApiCredential[]
 customerApiGrants CustomerApiControlGrant[]
 customerApiBudgets CustomerApiBudget[]
 customerApiObservations CustomerApiObservation[]
 customerApiOperations CustomerApiOperation[]
 trainingCurricula TrainingCurriculum[]
 trainingRequirements TrainingRequirement[]
 trainingEnrollments TrainingEnrollment[]
 trainingAssignments TrainingAssignment[]
 trainingAttempts TrainingAttempt[]
 trainingOperations TrainingOperation[]
 products CompanyProduct[]
 evidenceApplicabilities EvidenceApplicability[]
 evidenceProductLinks EvidenceProductLink[]
 qualityCases QualityCase[]
 qualityActions QualityAction[]
 qualityEffectiveness QualityEffectiveness[]
 qualityOperations QualityOperation[]
 knowledgeIndexes KnowledgeIndexRun[]
 knowledgeChunks KnowledgeChunk[]
 knowledgeSearches KnowledgeSearchRun[]
 risks RiskRecord[]
 riskControls RiskControl[]
 riskTreatments RiskTreatment[]
 riskReviews RiskReview[]
 connectorControlLinks ConnectorControlLink[]
 dispatchLanes DispatchLane[]
 automationEvents AutomationEvent[]
 accessInventories AccessInventory[]
 accessCampaigns AccessCampaign[]
 accessItems AccessReviewItem[]
 assuranceAnswers AssuranceAnswer[]
 questionnaires AssuranceQuestionnaire[]
 questionnaireDrafts QuestionnaireDraftRun[]
 changeResponses ChangeResponse[]
