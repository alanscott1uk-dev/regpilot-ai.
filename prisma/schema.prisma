  ocrStartedRuns OcrRun[] @relation("OcrStarter")
  ocrPreparedReviews OcrReview[] @relation("OcrPreparer")
  ocrReviewedTranscriptions OcrReview[] @relation("OcrReviewer")
  policyReleasesPrepared PolicyRelease[] @relation("PolicyReleasePreparer")
  signatureChallenges DocumentSignatureChallenge[] @relation("DocumentChallengeActor")
  documentAttestations DocumentAttestation[] @relation("DocumentAttestationActor")
  effectivityOperations PolicyEffectivityOperation[] @relation("PolicyEffectivityActor")
