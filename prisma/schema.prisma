 trainingAttempts TrainingAttempt[] @relation("TrainingAttemptLearner")
 trainingAttemptsReviewed TrainingAttempt[] @relation("TrainingAttemptReviewer")
 trainingOperations TrainingOperation[] @relation("TrainingOperationActor")
